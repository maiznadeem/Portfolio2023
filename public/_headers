/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://fast.wistia.com https://fast.wistia.net https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.wistia.com https://*.wistia.net https://raw.githubusercontent.com; media-src 'self' blob: https://*.wistia.com https://*.wistia.net; connect-src 'self' https://*.wistia.com https://*.wistia.net; font-src 'self' data: https://fast.wistia.com; worker-src 'self' blob:; frame-src https://fast.wistia.net; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
